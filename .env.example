# =====================================================================
# TypeSafe AI Jev System 1 Gatekeeper Environment Configuration
# Copy this file to .env and configure your secret credentials:
#   cp .env.example .env
# =====================================================================

# ---------------------------------------------------------------------
# 1. TypeSafe AI Jev System 1 Core (Live API)
# ---------------------------------------------------------------------
# Obtain your live System 1 API Key from https://typesafe.ai
TYPESAFE_API_KEY=

# TypeSafe AI System 1 Endpoint URL (Strictly /v1/systemone)
TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone

# TypeSafe AI Model Identifier (Strictly 'jev-latest' for System 1 API)
TYPESAFE_MODEL=jev-latest

# Gateway Evaluation Mode:
#   "live"      -> Evaluates traffic using live TypeSafe AI System 1 API (<15ms)
#   "simulated" -> Uses offline calibrated probability distribution for zero-cost demos
JEV_MODE=live

# ---------------------------------------------------------------------
# 2. Upstream AI Providers (Optional - For live API proxy passthrough)
# ---------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ---------------------------------------------------------------------
# 3. Sandbox Administration & Security
# ---------------------------------------------------------------------
SANDBOX_ADMIN_KEY=jev-aidr-admin-2026
ENVIRONMENT=development
DEBUG=true

# ---------------------------------------------------------------------
# 4. AIDR Policy Gating Thresholds (Calibrated Urgency Score 0.0 to 1.0)
# ---------------------------------------------------------------------
ALLOW_THRESHOLD=0.30
SILENT_LOG_THRESHOLD=0.60
NUDGE_THRESHOLD=0.80
REDACT_THRESHOLD=0.92
BLOCK_THRESHOLD=0.92

# ---------------------------------------------------------------------
# 5. Modal Serverless Deployment (Optional)
# ---------------------------------------------------------------------
# Name of remote Modal secret if not using local .env
MODAL_SECRET_NAME=aidr-sandbox-secrets
